[sub_resource type="CanvasItemMaterial" id="CanvasItemMaterial_ijgaf"]
blend_mode = 1

[sub_resource type="Resource" id="Resource_h2sm1"]
script = ExtResource("7_4a6i5")
text = "Defeat monsters by attacking their [color=#d1ae3d]limbs[/color]!

Dealing enough damage to a limb will [color=#d1ae3d]cut it off[/color]!

A monster with missing limbs has a lowered [color=#d1ae3d]defense[/color] and [color=#d1ae3d]damage[/color] output."
video = ExtResource("8_3dmww")
metadata/_custom_type_script = "uid://emcsn5t5bncn"

[sub_resource type="Resource" id="Resource_4a6i5"]
script = ExtResource("7_4a6i5")
text = "[color=#d1ae3d]Vital[/color] limbs are limbs that will immediately kill the monsters when they're cut off!

Common vital limbs are the [color=#d1ae3d]head[/color] and the [color=#d1ae3d]torso[/color].

The more non-vital limbs a monster has, the lower the [color=#d1ae3d]hit-chance[/color] of the [color=#d1ae3d]vital[/color] limbs, so choose your attacks wisely."
video = ExtResource("9_3dmww")
metadata/_custom_type_script = "uid://emcsn5t5bncn"

[sub_resource type="Resource" id="Resource_si0bq"]
script = ExtResource("7_4a6i5")
text = "Red-highlighted limbs are the ones that the monsters will attack you with.

The attacking limb also shows the amount of [color=#d1ae3d]potential damage[/color] it will deal."
image = ExtResource("10_3dmww")
metadata/_custom_type_script = "uid://emcsn5t5bncn"

[sub_resource type="Resource" id="Resource_j3cqa"]
script = ExtResource("7_4a6i5")
text = "Actions are done using [color=#d1ae3d]moves[/color].

Using a move costs [color=#d1ae3d]Energy[/color]. Some moves are stronger than others, and will require more [color=#d1ae3d]Energy[/color], so choose wisely. 

When you run out of [color=#d1ae3d]Energy[/color], end your turn. After each round, your [color=#d1ae3d]Energy[/color] points get replenished."
image = ExtResource("11_3dmww")
metadata/_custom_type_script = "uid://emcsn5t5bncn"

